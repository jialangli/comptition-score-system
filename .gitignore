# Go build artifacts
*.exe
*.dll
*.so
*.dylib
bin/
dist/

# Test artifacts
*.test
*.out
coverage.html
coverage.out

# PostgreSQL runtime data (if accidentally placed inside project)
pgdata/
pgsql/

# Temporary smoke-test directories
.smoke-tmp.*

# IDE / OS metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dependency cache (vendor if not committed)
vendor/

# Local env overrides (keep env.sample tracked)
.env

# 损坏的 .git 现场备份（2026-09-30 与 2026-10-04 各一次，均由 git stash 触发）
# 仅为本地排查留档，绝不能进仓库
.git.corrupt-*/
.git.broken-*/

# 基准文件的手工备份（正式基准在 testdata/frontend_golden.json）
testdata/*.bak-*

# 原型改前备份（带「改前备份」字样的副本，仅供本地回滚）
*改前备份*
